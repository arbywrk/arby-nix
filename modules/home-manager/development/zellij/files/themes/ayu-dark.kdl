// Ayu Dark chrome, tuned to blend with Yaru-dark's actual near-black
// rather than Ayu's own stock blue-black -- ghostty.nix's custom
// "Ayu Dark Gray" theme applies the same tweak, both derived from Ayu's
// real palette (ghostty's bundled Ayu theme file, share/ghostty/themes/
// Ayu) with two substitutions throughout: background/base slots that were
// Ayu's blue-black (#0B0E14 / 11 14 20) are now #131313 / 19 19 19 -- read
// straight out of Yaru-dark's own gnome-shell.css (`#panel {
// background-color: #131313; }`), not guessed -- and Ayu's navy selection
// background (#1B3A5B / 27 58 91) is now a plain mid gray (60 60 60); the
// one saturated sky-blue accent (Ayu's bright blue, #59C2FF / 89 194 255,
// used for the active-tab/mode-pill highlight) is now Ayu's own bright
// warm gold (#FFB454 / 255 180 84) instead, so the "brighter than resting"
// pop stays warm rather than blue. Nvim's own ayu-dark colorscheme (its
// own plugin-generated palette, not this file) is untouched -- its syntax
// highlighting reads as far less "blue" in practice than a full-block
// background or status-bar fill does. Role structure (which slot feeds
// the mode-pill keys, the one_line_ui status bar, etc.) is carried over
// unchanged from the original vague.kdl this ultimately descends from --
// that mapping was verified against status-bar's own source
// (default-plugins/status-bar/src/one_line_ui.rs).
themes {
    ayu-dark {
        text_unselected {
            base 191 189 182
            background 19 19 19
            emphasis_0 230 180 80
            emphasis_1 255 180 84
            emphasis_2 230 180 80
            emphasis_3 230 180 80
        }
        text_selected {
            base 191 189 182
            background 60 60 60
            emphasis_0 230 180 80
            emphasis_1 255 180 84
            emphasis_2 127 217 98
            emphasis_3 210 166 255
        }
        ribbon_selected {
            base 19 19 19
            background 255 180 84
            emphasis_0 230 180 80
            emphasis_1 230 180 80
            emphasis_2 210 166 255
            emphasis_3 230 180 80
        }
        ribbon_unselected {
            base 19 19 19
            background 191 189 182
            emphasis_0 230 180 80
            emphasis_1 191 189 182
            emphasis_2 230 180 80
            emphasis_3 210 166 255
        }
        table_title {
            base 127 217 98
            background 0
            emphasis_0 230 180 80
            emphasis_1 255 180 84
            emphasis_2 127 217 98
            emphasis_3 210 166 255
        }
        table_cell_selected {
            base 191 189 182
            background 60 60 60
            emphasis_0 230 180 80
            emphasis_1 255 180 84
            emphasis_2 127 217 98
            emphasis_3 210 166 255
        }
        table_cell_unselected {
            base 191 189 182
            background 19 19 19
            emphasis_0 230 180 80
            emphasis_1 255 180 84
            emphasis_2 127 217 98
            emphasis_3 210 166 255
        }
        list_selected {
            base 191 189 182
            background 60 60 60
            emphasis_0 230 180 80
            emphasis_1 255 180 84
            emphasis_2 127 217 98
            emphasis_3 210 166 255
        }
        list_unselected {
            base 191 189 182
            background 19 19 19
            emphasis_0 230 180 80
            emphasis_1 255 180 84
            emphasis_2 127 217 98
            emphasis_3 210 166 255
        }
        frame_selected {
            base 255 180 84
            background 0
            emphasis_0 230 180 80
            emphasis_1 255 180 84
            emphasis_2 210 166 255
            emphasis_3 0
        }
        frame_highlight {
            base 230 180 80
            background 0
            emphasis_0 210 166 255
            emphasis_1 230 180 80
            emphasis_2 230 180 80
            emphasis_3 230 180 80
        }
        exit_code_success {
            base 127 217 98
            background 0
            emphasis_0 255 180 84
            emphasis_1 19 19 19
            emphasis_2 210 166 255
            emphasis_3 255 180 84
        }
        exit_code_error {
            base 234 108 115
            background 0
            emphasis_0 255 180 84
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 210 166 255
            player_2 255 180 84
            player_3 0
            player_4 255 180 84
            player_5 144 225 198
            player_6 0
            player_7 234 108 115
            player_8 0
            player_9 0
            player_10 0
        }
    }
}
