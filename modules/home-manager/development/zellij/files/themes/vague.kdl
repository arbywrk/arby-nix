// Hand-built to match this config's own vague.nvim palette exactly (see
// modules/home-manager/development/neovim/files/lua/plugins/colorscheme.lua)
// rather than using a generic bundled theme, so zellij's chrome and nvim's
// editor colors are the same palette.
themes {
    vague {
        text_unselected {
            base 205 205 205
            background 20 20 21
            emphasis_0 224 163 99
            emphasis_1 126 152 232
            emphasis_2 127 165 99
            emphasis_3 187 157 189
        }
